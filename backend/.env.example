# ==============================================================
# CampusGraph Backend Configuration
# Academic Project: Graph-Based College Social Network with Fraud Detection
# ==============================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Neo4j Database Configuration
# Local Neo4j Desktop / Community / Docker: bolt://localhost:7687 or neo4j://localhost:7687
# Neo4j AuraDB (Cloud): neo4j+s://<dbid>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=campusgraph_password
NEO4J_DATABASE=neo4j

# JWT Authentication
JWT_SECRET=campusgraph_super_secret_jwt_key_2026_academic_project
JWT_EXPIRES_IN=7d

# Fraud Detection / Risk Threshold Settings (Initial Setup)
FRAUD_RISK_THRESHOLD=0.75

